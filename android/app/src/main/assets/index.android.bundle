aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0ab2\u0abe\u0a87\u0ab5 \u0ab8\u0acd\u0aa5\u0abe\u0aa8 \u0aae\u0ab3\u0ab6\u0ac7.",sos_confirm:"\u0ab9\u0aae\u0aa3\u0abe\u0a82 SOS \u0aae\u0acb\u0a95\u0ab2\u0acb",sos_dispatched_title:"\u0a95\u0a9f\u0acb\u0a95\u0a9f\u0ac0 SOS \u0aae\u0acb\u0a95\u0ab2\u0abe\u0aaf\u0acb",sos_dispatched_message:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0ab2\u0abe\u0a87\u0ab5 \u0ab8\u0acd\u0aa5\u0abe\u0aa8 \u0ab8\u0abe\u0aa5\u0ac7 \u0a89\u0a9a\u0acd\u0a9a \u0aaa\u0acd\u0ab0\u0abe\u0aa5\u0aae\u0abf\u0a95\u0aa4\u0abe\u0aa8\u0ac0 \u0a9a\u0ac7\u0aa4\u0ab5\u0aa3\u0ac0 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0a8f\u0aa1\u0aae\u0abf\u0aa8\u0abf\u0ab8\u0acd\u0a9f\u0acd\u0ab0\u0ac7\u0a9f\u0ab0 \u0a85\u0aa8\u0ac7 \u0aa8\u0a9c\u0ac0\u0a95\u0aa8\u0abe \u0ab8\u0ac7\u0ab5\u0a95\u0acb\u0aa8\u0ac7 \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7.",sos_failed_title:"SOS \u0aae\u0acb\u0a95\u0ab2\u0ac0 \u0ab6\u0a95\u0abe\u0aaf\u0acb \u0aa8\u0aa5\u0ac0",sos_failed_message:"\u0a95\u0a9f\u0acb\u0a95\u0a9f\u0ac0 \u0a9a\u0ac7\u0aa4\u0ab5\u0aa3\u0ac0 \u0aae\u0acb\u0a95\u0ab2\u0ac0 \u0ab6\u0a95\u0abe\u0a88 \u0aa8\u0aa5\u0ac0. \u0aab\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0acb \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0ac0\u0aa7\u0ac0 \u0a95\u0a9f\u0acb\u0a95\u0a9f\u0ac0 \u0ab8\u0ac7\u0ab5\u0abe\u0aa8\u0ac7 \u0a95\u0ac9\u0ab2 \u0a95\u0ab0\u0acb.",emergency_disarmed_title:"\u0a95\u0a9f\u0acb\u0a95\u0a9f\u0ac0 \u0aac\u0a82\u0aa7 \u0a95\u0ab0\u0abe\u0a88",emergency_disarmed_message:"\u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0ab8\u0acd\u0aa5\u0abf\u0aa4\u0abf SAFE \u0aaa\u0ab0 \u0aaa\u0ac1\u0aa8\u0a83\u0ab8\u0acd\u0aa5\u0abe\u0aaa\u0abf\u0aa4 \u0aa5\u0a88. \u0a93\u0aa1\u0abf\u0a9f \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1 \u0ab8\u0abe\u0a9a\u0ab5\u0abe\u0aaf\u0acb.",handover_action:"\u0ab5\u0abf\u0ab9\u0abe\u0ab0 \u0ab9\u0ac7\u0aa8\u0acd\u0aa1\u0a93\u0ab5\u0ab0 (\u0a9c\u0ab5\u0abe\u0aac\u0aa6\u0abe\u0ab0\u0ac0 \u0aac\u0aa6\u0ab2\u0acb)",hold_action:"\u0aa5\u0acb\u0aad\u0acb / \u0a86\u0ab0\u0abe\u0aae",resume_action:"\u0ab5\u0abf\u0ab9\u0abe\u0ab0 \u0ab8\u0ac7\u0ab5\u0abe \u0aab\u0ab0\u0ac0 \u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0acb",hold_title:"\u0ab5\u0abf\u0ab9\u0abe\u0ab0 \u0aa5\u0acb\u0aad\u0abe\u0ab5\u0acb",hold_subtitle:"\u0aa5\u0acb\u0aa1\u0abe \u0ab8\u0aae\u0aaf\u0aa8\u0acb \u0ab5\u0abf\u0ab0\u0abe\u0aae \u0a96\u0acb\u0a9f\u0ac0 \u0ab8\u0acd\u0aa5\u0abf\u0ab0\u0aa4\u0abe \u0a9a\u0ac7\u0aa4\u0ab5\u0aa3\u0ac0 \u0a85\u0a9f\u0a95\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7.",hold_notice:"\u0aa5\u0acb\u0aad\u0ac7\u0ab2\u0abe \u0ab8\u0aae\u0aaf\u0ac7 \u0ab8\u0acd\u0ab5\u0a9a\u0abe\u0ab2\u0abf\u0aa4 \u0ab8\u0acd\u0aa5\u0abf\u0ab0\u0aa4\u0abe \u0a85\u0ab2\u0abe\u0ab0\u0acd\u0aae \u0a85\u0a9f\u0a95\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0a8f\u0aa1\u0aae\u0abf\u0aa8\u0abf\u0ab8\u0acd\u0a9f\u0acd\u0ab0\u0ac7\u0a9f\u0ab0\u0aa8\u0ac7 \u0a9c\u0abe\u0aa3 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7.",hold_reason:"\u0ab5\u0abf\u0ab0\u0abe\u0aae\u0aa8\u0ac1\u0a82 \u0a95\u0abe\u0ab0\u0aa3 \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb",hold_location:"\u0aa5\u0acb\u0aad\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0ab8\u0acd\u0aa5\u0ab3 / \u0aa8\u0abf\u0ab6\u0abe\u0aa8\u0ac0",hold_notes:"\u0ab5\u0aa7\u0abe\u0ab0\u0abe\u0aa8\u0ac0 \u0aa8\u0acb\u0a82\u0aa7 (\u0ab5\u0ac8\u0a95\u0ab2\u0acd\u0aaa\u0abf\u0a95)",hold_cancel:"\u0ab0\u0aa6 \u0a95\u0ab0\u0acb",hold_confirm:"\u0ab9\u0aae\u0aa3\u0abe\u0a82 \u0aa5\u0acb\u0aad\u0abe\u0ab5\u0acb",handover_title:"\u0ab5\u0abf\u0ab9\u0abe\u0ab0\u0aa8\u0ac0 \u0a9c\u0ab5\u0abe\u0aac\u0aa6\u0abe\u0ab0\u0ac0 \u0aac\u0aa6\u0ab2\u0acb",handover_contact:"\u0a86\u0a97\u0abe\u0aae\u0ac0 \u0ab8\u0ac7\u0ab5\u0a95\u0aa8\u0acb \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0a85\u0aa5\u0ab5\u0abe \u0a87\u0aae\u0ac7\u0a87\u0ab2 *",handover_location:"\u0ab9\u0ac7\u0aa8\u0acd\u0aa1\u0a93\u0ab5\u0ab0\u0aa8\u0ac1\u0a82 \u0ab8\u0acd\